MONGO_URI=mongodb://127.0.0.1:27017/takecare
JWT_SECRET=replace-with-strong-secret

# ----- 手機註冊／登入／Email 驗證 -----
# 未設定 SMTP 時：驗證碼印在後端 console，且 API 回傳 devCode（方便本機）
# 設定 SMTP 後：真的寄信；建議同時 AUTH_EXPOSE_CODES=false
# AUTH_EXPOSE_CODES=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TakeCare <noreply@example.com>"
# 測試帳固定密碼：Test1234!（patient/caregiver/family@test.com）

# Required for Firebase Cloud Messaging SOS push notifications.
# Option A: path to a downloaded Firebase Admin service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: inline service account JSON, useful for deployed environments.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ----- Google 登入（Web OAuth + App）-----
# Cloud Console 建立 OAuth「網頁應用程式」→ CLIENT_ID + SECRET
# App 深連結會開 /auth/google?mobile=1，成功後回 takecare://auth?token=...
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# 建議與 GOOGLE_CLIENT_ID 相同（網頁用戶端）；原生 SDK 驗票也會用到
# GOOGLE_WEB_CLIENT_ID=
# Android／iOS 原生用戶端（可選，多 audience 驗票）
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
MOBILE_OAUTH_SUCCESS_URL=takecare://auth

# ----- Apple 登入（iOS）-----
# App Store／開發者後台開啟 Sign in with Apple；填 Bundle ID 或 Services ID
# APPLE_CLIENT_ID=com.takecaremobile
# APPLE_BUNDLE_ID=com.takecaremobile

# Web and app redirect targets after Google login
FRONTEND_WEB_URL=http://localhost:5173
OAUTH_SUCCESS_URL=http://localhost:5173/google-success

# Add extra origins here when app is deployed, comma separated
# Example: https://takecare.app,https://api.takecare.app
CORS_ORIGINS=

# Fall-detection vision service endpoint (optional, pull-based fallback).
# Run vision_api_server.py (separate repo) and point here.
# If unset or unreachable, backend falls back to mock vision samples.
VISION_MODEL_ENDPOINT=http://localhost:8000/detect

# Shared secret vision-runtime uses to actively POST /vision/report when it CONFIRMS a fall
# (works even if the App is closed / not on the vision screen). Must match vision-runtime's
# VISION_SHARED_TOKEN env var. Generate with: openssl rand -hex 24
VISION_SHARED_TOKEN=replace-with-strong-shared-secret
